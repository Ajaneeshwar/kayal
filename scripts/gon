#!/usr/bin/env bash
# Copy the working tree to gon, build the web app there, and restart the server.
# Usage: scripts/gon [deploy|status|logs [lines]|stop]
set -euo pipefail

HOST=gon
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "${1:-deploy}" in
  deploy)
    rsync -az --delete \
      --exclude /.git --exclude node_modules --exclude /data --exclude /.env \
      --exclude /.firecrawl --exclude /.agents --exclude dist --exclude /server.log \
      "$ROOT/" "$HOST:hackathoni/"
    ssh "$HOST" 'bash -s' <<'REMOTE'
set -euo pipefail
cd ~/hackathoni
if [ -f web/package.json ]; then
  (cd web && npm install --no-audit --no-fund --loglevel=error && npm run build)
fi
NODE="$(command -v node)"
tmux kill-session -t kayal 2>/dev/null || true
tmux new-session -d -s kayal "$NODE server.mjs >> server.log 2>&1"
for _ in $(seq 1 20); do
  if curl -fsS http://127.0.0.1:3000/api/health; then echo; exit 0; fi
  sleep 0.5
done
echo 'The server did not answer. Last log lines:' >&2
tail -n 30 server.log >&2
exit 1
REMOTE
    ;;
  status) ssh "$HOST" 'curl -fsS http://127.0.0.1:3000/api/health; echo; tmux ls 2>&1' ;;
  logs) ssh "$HOST" "tail -n ${2:-60} ~/hackathoni/server.log" ;;
  stop) ssh "$HOST" 'tmux kill-session -t kayal' ;;
  *) echo 'usage: scripts/gon [deploy|status|logs [lines]|stop]' >&2; exit 2 ;;
esac
